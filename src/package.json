{
  "name": "features-toggle",
  "displayName": "Features Toggle",
  "description": "Features toggle extension",
  "version": "1.0.0",
  "publisher": "ProdWay",
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=20.19.2",
    "vscode": "^1.84.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "../dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "features-toggle-container",
          "title": "Features Toggle",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "features-toggle-container": [
        {
          "type": "webview",
          "id": "features-toggle.view",
          "name": "Features Toggle",
          "contextualTitle": "Features Toggle"
        }
      ]
    },
    "commands": [
      {
        "command": "featuresToggle.hello",
        "title": "Say Hello"
      }
    ]
  },
  "scripts": {
    "build": "node ../src/esbuild.mjs",
    "dev": "node ../src/esbuild.mjs --watch",
    "vsix": "vsce package --no-dependencies --allow-missing-repository --out ../../bin"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "esbuild": "^0.25.0",
    "typescript": "5.8.3",
    "@vscode/vsce": "^3.3.2"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.0",
    "he": "^1.2.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.25.0"
    }
  }
}
