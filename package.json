{
  "name": "features-toggle",
  "displayName": "Features Toggle",
  "description": "Features toggle extension",
  "version": "1.0.0",
  "publisher": "ProdWay",
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=20.19.2",
		"vscode": "^1.84.0"
	},
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "featuresToggle.hello",
        "title": "Say Hello"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "dev": "node esbuild.mjs --watch",
    "vsix": "vsce package --no-dependencies --allow-missing-repository --out ./bin"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "esbuild": "^0.25.0",
    "typescript": "5.8.3",
    "@vscode/vsce": "^3.3.2"
  },
  "pnpm": {
		"overrides": {
			"esbuild": ">=0.25.0"
		}
	}
}
